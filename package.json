{
  "name": "styled-components-project",
  "private": true,
  "scripts": {
    "build": "pnpm --filter styled-components build",
    "sandbox": "pnpm --filter sandbox dev",
    "release": "pnpm --filter styled-components prepublishOnly && changeset publish",
    "postinstall": "pnpm --filter styled-components generateErrors",
    "prepare": "husky",
    "prettier": "pnpm --filter styled-components prettier:check",
    "size": "pnpm --filter styled-components size",
    "test": "pnpm --filter styled-components test",
    "test:prerelease-notes": "node scripts/prerelease-release-notes.cjs"
  },
  "author": "Glen Maddern",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/styled-components/styled-components/issues"
  },
  "homepage": "https://styled-components.com",
  "engines": {
    "node": ">= 14"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "husky": "9.1.7"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8.0.0",
      "@types/react": "18.3.28",
      "baseline-browser-mapping": ">=2.11.0 <3.0.0",
      "brace-expansion": ">=2.1.4",
      "browserslist": ">=4.28.7 <5.0.0",
      "d3-color": ">=3.1.0",
      "fast-uri": ">=3.1.6 <4.0.0",
      "fast-xml-builder": ">=1.1.7 <2.0.0",
      "fast-xml-parser": ">=5.7.0 <6.0.0",
      "joi": ">=17.13.6 <18.0.0",
      "js-cookie": ">=3.0.6 <4.0.0",
      "js-yaml@3": ">=3.15.2 <4.0.0",
      "js-yaml@4": ">=4.3.2 <5.0.0",
      "lodash": ">=4.17.21",
      "minimatch": ">=3.1.3",
      "nanoid": ">=3.3.18 <4.0.0",
      "picomatch": ">=4.0.2",
      "postcss": ">=8.5.23 <9.0.0",
      "postcss-selector-parser": ">=7.1.3 <8.0.0",
      "serialize-javascript": ">=7.0.5",
      "shell-quote": ">=1.9.0 <2.0.0",
      "ws@6": ">=6.2.4 <7.0.0",
      "ws@7": ">=7.5.11 <8.0.0",
      "ws@8": ">=8.21.0 <9.0.0",
      "yaml": ">=2.7.1"
    }
  }
}
