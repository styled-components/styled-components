{
  "name": "styled-components-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter styled-components build",
    "sandbox": "pnpm --filter sandbox dev",
    "release": "pnpm --filter styled-components prepublishOnly && changeset publish",
    "postinstall": "pnpm --filter styled-components generateErrors",
    "prepare": "husky",
    "format": "biome check --write",
    "format:check": "biome ci",
    "knip": "knip --config knip.jsonc",
    "lint-staged": "lint-staged",
    "size": "pnpm --filter styled-components size",
    "test": "pnpm --filter styled-components test",
    "test:changeset-changelog": "node --test scripts/release-notes/changelog.test.ts scripts/release-notes/prerelease-aggregation.test.ts scripts/release-notes/build-version-pr-body.test.ts",
    "test:effect-gate": "node --test scripts/effect-gate.test.ts",
    "dry-run:prerelease-notes": "node scripts/release-notes/build-prerelease-release-notes.ts",
    "dry-run:version-pr-body": "node scripts/release-notes/build-version-pr-body.ts",
    "verify": "node scripts/verify.mjs"
  },
  "author": "Glen Maddern",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/styled-components/styled-components/issues"
  },
  "homepage": "https://styled-components.com",
  "engines": {
    "node": ">= 14"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "^2.27.7",
    "@changesets/git": "3.0.4",
    "@changesets/read": "0.6.7",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19",
      "@types/react-dom": "19",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "fast-xml-parser": ">=5.7.0",
      "postcss": ">=8.5.10",
      "serialize-javascript": ">=7.0.5",
      "shell-quote": ">=1.8.4"
    }
  }
}
