{
  "name": "styled-components-project",
  "private": true,
  "scripts": {
    "build": "pnpm --filter styled-components build",
    "check:type-resolution": "node scripts/check-type-resolution.mjs packages/styled-components/tsconfig.json packages/styled-components/tsconfig.test-types.json packages/sandbox/tsconfig.json",
    "sandbox": "pnpm --filter sandbox dev",
    "release": "pnpm --filter styled-components prepublishOnly && changeset publish",
    "postinstall": "pnpm --filter styled-components generateErrors",
    "prepare": "husky",
    "prettier": "pnpm --filter styled-components prettier:check",
    "size": "pnpm --filter styled-components size",
    "test": "pnpm --filter styled-components test",
    "test:prerelease-notes": "node scripts/prerelease-release-notes.cjs"
  },
  "author": "Glen Maddern",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/styled-components/styled-components/issues"
  },
  "homepage": "https://styled-components.com",
  "engines": {
    "node": ">= 14"
  },
  "packageManager": "pnpm@12.11.1",
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "husky": "9.1.7"
  }
}
